flowchart TB
  classDef input fill:#F1F5F9,stroke:#64748B,color:#0F172A
  classDef shared fill:#EFF6FF,stroke:#2563EB,color:#0F172A
  classDef live fill:#ECFDF5,stroke:#059669,color:#0F172A
  classDef app fill:#F5F3FF,stroke:#7C3AED,color:#0F172A
  classDef evals fill:#FFF7ED,stroke:#EA580C,color:#0F172A
  classDef store fill:#FFFFFF,stroke:#2563EB,stroke-width:2px,color:#0F172A

  subgraph INPUTS["Inputs"]
    direction LR
    PM["Prediction markets<br/>Polymarket, Kalshi"] ~~~ MKT["Market data (Massive)<br/>prices, ETF holdings, options"] ~~~ HL["Hyperliquid<br/>weekend and holiday<br/>perp prices"] ~~~ CL["Claude and Laya<br/>AI-assisted steps"]
  end

  subgraph SHARED["Shared layer: runs on a schedule, same for every user"]
    direction LR
    FUN["1. Event funnel<br/>Laya screens thousands<br/>of markets to ~250 events"] --> MAT["2. Matcher<br/>match score, ladders,<br/>nothing-fits rule"] --> EVI["3. Evidence<br/>odds, options, jump windows,<br/>past events, AI prior"] --> FUS["4. Fusion and quorum<br/>earned source weights,<br/>tiers A to D"] --> GRA["5. Event graph<br/>links, knock-on effects,<br/>coherence checks"]
  end

  LIB[("Event library<br/>odds q, jump vector δ, tier<br/>saved as daily snapshots")]

  subgraph LIVE["Per-portfolio layer: runs live"]
    direction LR
    EXP["6. Exposure engine<br/>ETF look-through,<br/>arrow b, fit score"] --> RANK["7. Rank by swing<br/>top ~100 events<br/>for this portfolio"] --> IMP["8. Impact<br/>Δ = b · δ,<br/>net of what is priced in"] --> SIM["9. Scenario simulator<br/>thousands of<br/>possible futures"]
  end

  subgraph APP["App"]
    direction LR
    BUILD["Portfolio builder"] ~~~ VIEWS["3D risk map, ranked list,<br/>event cards, outcome chart"] ~~~ REPLAY["Historical replay<br/>uses as-of snapshots"]
  end

  subgraph EVALS["Evals and backtests"]
    direction LR
    BT["Matcher accuracy, calibration, jump accuracy,<br/>historical replay, AI-only baseline"]
  end

  INPUTS --> SHARED
  SHARED --> LIB
  LIB --> LIVE
  APP -- portfolio in --> LIVE
  LIVE -- results out --> APP
  LIB -. resolved events .-> EVALS
  EVALS -. source weights and long-shot correction .-> SHARED

  class PM,MKT,HL,CL input
  class FUN,MAT,EVI,FUS,GRA shared
  class LIB store
  class EXP,RANK,IMP,SIM live
  class BUILD,VIEWS,REPLAY app
  class BT evals
